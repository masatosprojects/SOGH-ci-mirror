      ],
      "value": {
        "allowed": {
          "type": "string"
        },
        "not_accepted": {
          "type": "string"
        },
        "ai_text_underline_required": {
          "type": "boolean",
          "description": "AI（文章チェックを含む）が生成・修正した箇所と、その修正で間接的に影響した箇所に、下線が必要か。任意項目・null不可（不明なら項目を省略）"
        },
        "simple_spellcheck_underline_required": {
          "type": "boolean",
          "description": "文書校正機能による『単純な誤字脱字の修正だけ』に下線が必要か（AIが内容を生成・修正する場合全般の免除ではない）。任意項目・null不可"
        },
        "human_advice_underline_required": {
          "type": "boolean",
          "description": "他人の添削・助言による修正に下線が必要か（AIの修正とは別の対象）。任意項目・null不可"
        },
        "human_advice_activity_report_required": {
          "type": "boolean",
          "description": "他人の添削・助言による修正を活動経過報告書に記載することが必須か（『下線不要』は『報告不要』を意味しない）。任意項目・null不可"
        },
        "ai_visual_disclosure_required": {
          "type": "boolean",
          "description": "AIで作成した画像・図・表等の使用を、説明文や脚注に明示することが必須か（文章の下線とは別の義務）。任意項目・null不可"
        }
      },
      "cues": [
        "生成AI"
      ],
      "assertions": [
        {
          "id": "ai_use_allowed",
          "when": {
            "field": "allowed",
            "nonempty": true
          },
          "must_any": [
            "認め",
            "利用",
            "使",
            "補助"
          ],
          "forbid_any": [
            "lex:permission_negation"
          ],
          "category": "polarity_mismatch",
          "message": "生成AIの利用は条件つきで認められている（禁止・不可にしていない）"
        },
        {
          "id": "ai_output_not_accepted",
          "when": {
            "field": "not_accepted",
            "nonempty": true
          },
          "must_any": [
            "みなさ",
            "認め",
            "受け付け",
            "とされ"
          ],
          "category": "qualifier_dropped",
          "message": "AIが生成したものを独自の成果物とはみなさない、という限定が本文で落ちている"
        },
        {
          "id": "ai_text_underline_true",
          "when": {
            "field": "ai_text_underline_required",
            "equals": true
          },
          "must_any": [
            "re:(生成|AI)[^。]{0,60}下線を引"
          ],
          "forbid_any": [
            "re:(生成|AI|文章チェック)[^。]{0,60}下線[^。]{0,8}{lex:necessity_negation}",
            "re:(生成|AI)[^。]{0,60}下線(は|を)?(引か(ない|なくて)|付けなくて)"
          ],
          "category": "polarity_mismatch",
          "message": "AI（文章チェックを含む）が生成・修正した箇所には下線が必要（ai_text_underline_required=true）。『下線不要』にしていない"
        },
        {
          "id": "simple_spellcheck_underline_false",
          "when": {
            "field": "simple_spellcheck_underline_required",
            "equals": false
          },
          "must_any": [
            "re:(誤字脱字|校正)[^。]{0,40}下線[^。]{0,8}{lex:necessity_negation}"
          ],
          "category": "polarity_mismatch",
          "message": "単純な誤字脱字の文書校正だけが下線不要（simple_spellcheck_underline_required=false）。同じ文で『不要』と言っていない、または例外が落ちている"
        },
        {
          "id": "human_advice_underline_false",
          "when": {
            "field": "human_advice_underline_required",
            "equals": false
          },
          "must_any": [
            "re:(他人|第三者|人)の(添削|助言)[^。]{0,40}下線[^。]{0,8}{lex:necessity_negation}"
          ],
          "category": "polarity_mismatch",
          "message": "他人の添削・助言による修正は下線不要（human_advice_underline_required=false）。同じ文で『不要』と言っていない、または例外が落ちている"
        },
        {
          "id": "human_advice_report_true",
          "when": {
            "field": "human_advice_activity_report_required",
            "equals": true
          },
          "must_any": [
            "re:活動経過報告書[^。]{0,30}(記載|記入)[^。]{0,20}(必須|必要です|必要があります|求められ)"
          ],
          "forbid_any": [
