      "cues": [
        "出願資格",
        "資格",
        "条件",
        "該当"
      ],
      "assertions": [
        {
          "id": "eligibility_not_waived",
          "forbid_any": [
            "re:(満たす|該当する)(こと)?(は|が)?{lex:necessity_negation}",
            "re:条件.{0,8}{lex:necessity_negation}",
            "re:資格.{0,8}{lex:necessity_negation}"
          ],
          "category": "polarity_mismatch",
          "message": "出願資格の条件が『不要』の意味に反転している"
        },
        {
          "id": "eligibility_stays_a_duty",
          "sentence_if": [
            "re:出願資格[^。]{0,40}満たす"
          ],
          "sentence_must": [
            "re:満たす(こと)?(が|は|を)?[^。]{0,6}(必要|求められ|条件|要件|必須)",
            "re:(必要|求められ|必須)[^。]{0,12}満たす"
          ],
          "category": "polarity_mismatch",
          "message": "出願資格の条件を『満たすことが必要』という述語が、別の言い回しに置き換わっている"
        }
      ]
    },
