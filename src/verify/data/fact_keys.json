      ],
      "must_any": [
        "re:(別途|引き続き)?(確認|照会|相談|問い合わせ)(が|は)?(必要|求められ|欠かせ)",
        "re:(確認|ご覧|参照|照会|相談|問い合わせ)(し)?(て)?(ください|する必要)",
        "re:(別途|さらに|改めて)必要(です|となります|があります|とされます)",
