      "value": {
        "logic": {
          "type": "string",
          "required": true,
          "role": "logic",
          "description": "any_of_1_to_N（いずれか）／all_of_1_to_N（全て）"
        },
        "details_page": {
          "type": "integer",
          "kind": "page_ref",
          "description": "各区分の条件が書かれた要項のページ"
