  "qualitative_rules": [
    {
      "id": "hedge_kept",
      "when": {
        "field": "qualifier",
        "regex": "(場合(が|も)あ|ことがある|可能性|延期等)"
      },
      "must_any": [
        "re:(場合|ことがあ|可能性|とは限|おそれ|かもしれ)"
      ],
      "category": "qualifier_dropped",
      "message": "根拠の注記にある『場合がある』（例外・ヘッジ）が本文で落ちている"
    },
    {
      "id": "limit_kept",
      "when": {
        "field": "qualifier",
        "regex": "(に限り|のみ|に限る|限ります)"
      },
      "must_any": [
        "re:(に限り|のみ|限ります|限る)"
      ],
      "category": "qualifier_dropped",
      "message": "根拠の注記にある限定（『〜に限り』『のみ』）が本文で落ちている"
    },
    {
      "id": "extension_not_denied",
      "when": {
        "field": "qualifier",
        "regex": "延長"
      },
      "forbid_any": [
        "re:延長(しません|されません|されない|はありません|はない|しない|なし|不可|できません)"
      ],
      "category": "qualifier_contradicted",
      "message": "根拠は『延長する場合がある』のに、本文は延長を否定している"
    },
    {
      "id": "no_visit_kept",
      "when": {
        "field": "qualifier",
        "contains": "持参不可"
      },
      "must_any": [
        "re:持参[^。]{0,12}(できません|不可|受け付けません|認められません|お断り|ご遠慮|禁止|不可能|不可です)"
      ],
      "category": "qualifier_dropped",
      "message": "根拠の『持参不可』が、『持参はできません』のような禁止の述語として本文に残っていない"
    },
    {
      "id": "no_visit_not_denied",
      "when": {
        "field": "qualifier",
        "contains": "持参不可"
      },
      "forbid_any": [
        "re:持参(は|も|が)?(でき(ます|る)|可(能|です)?|受け付けます|お受けします|構いません|OK)"
      ],
      "category": "qualifier_contradicted",
      "message": "根拠は『持参不可』なのに、本文は持参を認めている"
    },
    {
      "id": "no_unconditional_claim",
      "when": {
        "field": "qualifier",
        "regex": "(場合(が|も)あ|ことがある|可能性|延期等|に限り|のみ|に限る|限ります)"
      },
      "forbid_any": [
        "必ず",
        "例外なく",
        "常に",
        "無条件",
        "いかなる場合も",
        "re:一律"
      ],
      "category": "unconditional_assertion",
      "message": "根拠は限定・例外つきなのに、本文は無条件の断定になっている"
    }
  ],
  "article_rules": [
    {
      "id": "caveat_not_reversed",
      "forbid_any": [
        "re:(最新版|最新の訂正|最新情報|追加案内|訂正|個別判定|確認).{0,16}{lex:necessity_negation}",
