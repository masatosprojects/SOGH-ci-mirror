  "scopes": {
    "target_admission_cycle": {
      "semantics": "cycle",
      "description": "対象の入試サイクル全体に適用される情報"
    },
    "department_and_method": {
      "semantics": "unit",
      "description": "学部・学科と入試方式の組に限って適用される情報（他の学科へ流用しない）"
    },
    "faculty_annual_AO_aggregate": {
      "semantics": "aggregate",
      "description": "年度内に実施する複数回の入試の合計。単独の回・方式の枠ではない"
    }
  },
  "scope_patterns": [
    {
      "pattern": "^all_[A-Za-z0-9_]+$",
      "semantics": "all_units",
      "description": "all_<大学・方式> 形式。その方式のすべての学部・学類に共通する情報"
    }
  ],
  "negation_cues": [
    "ではありません",
    "ではない",
    "ではなく",
    "読み替え",
    "断定できません",
    "とは限りません",
    "区別",
    "別のもの"
  ],
  "rules": {
    "aggregate_total": {
      "category": "scope_reinterpretation",
      "description": "年度内合計の人数は『合計』と書き、『単独』の枠として書かない",
      "required_any": [
        "合計",
        "総数",
        "全体"
      ],
      "required_message": "is an aggregate but the text does not say it is a 合計 / total",
      "forbidden_unless_negated": [
        "単独"
      ],
      "forbidden_message": "is an aggregate; the text presents it as a 単独 figure"
    },
    "time_window_not_net": {
      "category": "scope_reinterpretation",
      "description": "面接の『実施時間の枠』を、実質の質疑時間として書かない",
      "required_any": [
        "枠",
        "実施時間"
      ],
      "required_message": "is a time window; the text does not say 枠 / 実施時間",
      "forbidden_unless_negated": [
        "質疑"
      ],
      "forbidden_message": "is an allocated time window, not net question time; the text equates them"
    },
    "one_of_dates": {
      "category": "scope_reinterpretation",
      "description": "『いずれか』の候補日を、両日として書かない",
      "required_any": [
        "いずれか",
        "どちらか"
      ],
      "required_message": "lists dates of which only one applies; the text does not say いずれか",
      "forbidden_unless_negated": [
        "両日",
        "全日程",
        "すべての日"
      ],
      "forbidden_message": "dates are alternatives, but the text implies all of them"
    },
    "logic_any_of": {
      "category": "logic_mismatch",
      "description": "OR条件（いずれか）を、全て満たす条件として書かない",
      "required_any": [
        "いずれか"
      ],
      "required_message": "is an OR condition; the text does not say いずれか",
      "forbidden_patterns": [
        "(全て|すべて)(を)?満たす"
      ],
      "forbidden_message": "is an OR condition but the text says all must be met"
    },
    "logic_all_of": {
      "category": "logic_mismatch",
      "description": "AND条件（全て）を、いずれか1つでよいとして書かない",
      "required_any_pattern": [
        "全て|すべて|いずれも"
      ],
      "required_message": "is an AND condition; the text does not say 全て",
      "forbidden_patterns": [
        "いずれかに該当"
      ],
      "forbidden_message": "is an AND condition but the text says any one suffices"
    },
    "all_dates_listed": {
      "engine": "dates_listed",
      "category": "date_omitted",
      "description": "候補日が複数あるとき、一部だけを書かない"
    }
  },
  "semantic_triggers": [
    {
      "field": "scope",
      "contains": "aggregate",
      "rule": "aggregate_total"
    },
    {
      "field": "value.type",
      "regex": "window.*not_net",
      "rule": "time_window_not_net"
    },
    {
      "field": "value.selection",
      "equals": "one_of_not_both",
      "rule": "one_of_dates"
    },
    {
      "field": "value.logic",
      "startswith": "any_of",
      "rule": "logic_any_of"
    },
    {
      "field": "value.logic",
      "startswith": "all_of",
      "rule": "logic_all_of"
    },
    {
      "field": "value.dates",
      "min_items": 2,
      "rule": "all_dates_listed"
    }
  ],
