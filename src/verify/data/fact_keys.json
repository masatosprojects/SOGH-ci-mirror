          ],
          "forbid_any": [
            "re:(画像|図|表)[^。]{0,60}明示[^。]{0,6}{lex:necessity_negation}"
          ],
          "category": "polarity_mismatch",
          "message": "AIで作成した画像・図・表は使用の明示が必須（ai_visual_disclosure_required=true）。『明示不要』にしていない"
