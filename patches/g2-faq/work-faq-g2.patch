diff --git a/b/admissions_pipeline/headings.py b/admissions_pipeline/headings.py
new file mode 100644
index 0000000..815a879
--- /dev/null
+++ b/admissions_pipeline/headings.py
@@ -0,0 +1,38 @@
+"""Immediate question heading of a source position (proposal g2; companion of STR-076).
+
+The FAQ page is a list of question lines, each followed by its answer. A proof must name the question whose answer it quotes, not the section heading in
+front of the whole group of questions. The questions that hold the facts are DECLARED in the reviewed spec (`section_headings`, original wording); nothing
+is guessed from punctuation. Offsets are never touched: this module only reads the normalized text.
+"""
+import re
+
+from .extract import normalize
+
+
+def immediate_heading(text, start, end, scope_start, scope_end, headings):
+    """Return the declared heading (original wording) that owns the normalized span [start, end).
+
+    Fails closed (ValueError) when: no heading is declared; a declared heading is absent or occurs more than once inside the scope; no declared heading
+    starts at or before the span; the span starts inside a heading; a second declared heading starts inside the span (the span would quote two
+    questions); or an undeclared question mark lies between the heading and the span (an undeclared question is in between).
+    """
+    if not headings:
+        raise ValueError("no section headings are declared for this FAQ")
+    located = []
+    for heading in headings:
+        wanted = normalize(heading)
+        hits = list(re.finditer(re.escape(wanted), text[scope_start:scope_end]))
+        if len(hits) != 1:
+            raise ValueError("declared FAQ heading is absent or ambiguous")
+        located.append((scope_start + hits[0].start(), scope_start + hits[0].end(), heading))
+    before = [h for h in located if h[0] <= start]
+    if not before:
+        raise ValueError("no declared FAQ heading precedes this proof")
+    h_start, h_end, heading = max(before)
+    if h_start < start < h_end:
+        raise ValueError("proof starts inside a heading")
+    if any(start < other[0] < end for other in located):
+        raise ValueError("proof spans two FAQ questions")
+    if start >= h_end and "?" in text[h_end:start]:
+        raise ValueError("an undeclared question lies between the heading and the proof")
+    return heading
