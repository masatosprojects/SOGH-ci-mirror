diff --git a/admissions_pipeline/scope_evidence.py b/admissions_pipeline/scope_evidence.py
new file mode 100644
--- /dev/null
+++ b/admissions_pipeline/scope_evidence.py
@@ -0,0 +1,44 @@
+"""STR-101 (H3=B): what must exist before a FAQ page is bound to ONE year / faculty / method.
+
+The FAQ page itself does not say which cycle it applies to (STR-076). A configuration that merely names a cycle is not evidence. Binding needs an INDEPENDENT official source: an evidence id and the SHA-256 of
+a source document that is NOT the FAQ page, with the quote that states the year and the faculty, consistent with the cycle it is bound to. When a ``lookup`` (the evidence store) is given, the evidence id must exist
+there with the same source SHA and a text that holds the quote. Without a lookup only the structure, the independence and the consistency are checked (the result says so: ``store_checked`` False).
+No path here makes a record "verified"; a missing, self-referencing, inconsistent or unsupported evidence is an error and the record stays UNKNOWN (use scope_status 'unknown').
+"""
+import re
+import unicodedata
+
+KEYS = ("evidence_id", "source_sha256", "case_id", "fiscal_year", "faculty", "quote")
+
+
+def _flat(text):
+    return re.sub(r"\s+", "", unicodedata.normalize("NFKC", str(text)))
+
+
+def check_scope_evidence(spec, record, cycle, lookup=None):
+    ev = spec.get("scope_evidence")
+    if not isinstance(ev, dict) or any(k not in ev for k in KEYS):
+        raise ValueError("FAQ scope is not proven (STR-101): binding to a year / faculty needs an independent official evidence (scope_evidence: " + ", ".join(KEYS) + ")")
+    if not isinstance(ev["evidence_id"], str) or not ev["evidence_id"].strip():
+        raise ValueError("scope_evidence needs an evidence id")
+    sha = ev["source_sha256"]
+    if not isinstance(sha, str) or not re.fullmatch(r"[0-9a-f]{64}", sha):
+        raise ValueError("scope_evidence needs the SHA-256 of its source document")
+    if sha == record.get("sha256") or sha == spec.get("expected_sha256"):
+        raise ValueError("scope_evidence must come from a source other than the FAQ page itself (not independent)")
+    if type(ev["fiscal_year"]) is not int or ev["fiscal_year"] != cycle["fiscal_year"] or ev["fiscal_year"] != spec.get("fiscal_year") or ev["case_id"] != cycle["case_id"]:
+        raise ValueError("scope_evidence is not consistent with the cycle the FAQ is bound to")
+    faculty = _flat(ev["faculty"])
+    if not faculty or faculty not in {_flat(cycle.get("department", "")), _flat(cycle.get("faculty", ""))}:
+        raise ValueError("scope_evidence names another faculty than the cycle")
+    quote = _flat(ev["quote"])
+    year = ev["fiscal_year"]
+    if faculty not in quote or not (str(year) in quote or f"令和{year - 2018}" in quote):
+        raise ValueError("the quote of scope_evidence does not state the year and the faculty")
+    store_checked = False
+    if lookup is not None:
+        found = lookup(ev["evidence_id"])
+        if not isinstance(found, dict) or found.get("source_sha256") != sha or quote not in _flat(found.get("text", "")):
+            raise ValueError("scope_evidence is not registered in the evidence store with this source and quote")
+        store_checked = True
+    return {"evidence_id": ev["evidence_id"], "source_sha256": sha, "store_checked": store_checked}
diff --git a/admissions_pipeline/unconfirmed_faq.py b/admissions_pipeline/unconfirmed_faq.py
new file mode 100644
--- /dev/null
+++ b/admissions_pipeline/unconfirmed_faq.py
@@ -0,0 +1,50 @@
+"""The article section for an official FAQ whose applicability (year, faculty, method) the page does not state (STR-076). Proposal g2, second patch.
+
+Such a record has no ``case_id``: it is NEVER attached like a case-bound notice (``revise_article`` filters on the case), and it is never stated as a fact of one admission cycle. It is shown in its OWN section,
+under its OWN heading, that says first that the applicability is unconfirmed and where to check, then the confirmed conditions exactly as ``render_conditions`` derives them, each sentence cited to the record.
+The wording of ``NOTICE`` is the owner's (decision 2026-11-08: adopt the draft of patches/g2-faq/regenerated/README.md). Nothing here writes a database.
+"""
+import re
+
+from .extract import normalize
+from .faq_policy import render_conditions, validate_condition_bindings
+
+HEADING = "## 公式FAQの案内（適用年度・学類は未確認）"
+NOTICE = ("大学公式サイトのFAQ（AC入試の節）には、生成AIを使った場合の下線の引き方や、画像・図・表の扱いが書かれています。"
+          "ただし、このFAQの文面からは、どの年度・どの学類の出願に当てはまるかを確認できていません。"
+          "出願の際は、必ず最新の募集要項と、公式サイトのFAQ（{url}）、大学の窓口の案内で確認してください。")
+
+
+def is_unconfirmed_faq(record):
+    return record.get("condition_profile") == "tsukuba-ac-faq-v1" and record.get("scope_status") == "unknown"
+
+
+def render_unconfirmed_section(record):
+    """The section text (heading, the notice, then the derived sentences each cited to the record)."""
+    if not is_unconfirmed_faq(record):
+        raise ValueError("not an unconfirmed-scope FAQ record")
+    validate_condition_bindings(record)
+    cite = "[" + record["evidence_id"] + "]"
+    notice = NOTICE.format(url=record["source_url"])
+    # every derived SENTENCE is cited (an element of render_conditions may hold more than one sentence)
+    sentences = " ".join(p + cite + "。" for element in render_conditions(record["value"]) for p in element.split("。") if p.strip())
+    return HEADING + "\n\n" + notice + cite + "\n\n" + sentences + "\n\n"
+
+
+def check_unconfirmed_section(article_text, record):
+    """Controlled-template boundary (not independent QA): exactly one such section, equal to the rendering, the record cited only there, and the section states no year, faculty or cycle."""
+    validate_condition_bindings(record)
+    if article_text.count(HEADING) != 1:
+        raise ValueError("the unconfirmed FAQ section is absent or duplicated")
+    prefix, body = article_text.split(HEADING, 1)
+    following = re.search(r"\n#{1,3} ", body)
+    tail = body[following.start():] if following else ""
+    if following:
+        body = body[:following.start()]
+    outside = (prefix + tail).split("## 根拠資料", 1)[0]
+    if "[" + record["evidence_id"] + "]" in outside:
+        raise ValueError("an unconfirmed FAQ is cited outside its own section")
+    expected = render_unconfirmed_section(record)[len(HEADING):]
+    if normalize(body) != normalize(expected):
+        raise ValueError("the unconfirmed FAQ section differs from the controlled template")
+    return True
