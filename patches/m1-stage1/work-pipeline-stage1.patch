@@ -46,6 +46,18 @@
 """
 
 
+def configure_connection(db):
+    """M1 stage 1 (G-09): every SOGH connection that writes the evidence database is configured here.
+    `sogh_write_ok` is the write capability that the database's guard triggers call; a connection that does not register it is refused
+    by those triggers (fail closed). `recursive_triggers=ON` makes the implicit DELETE of INSERT OR REPLACE fire the delete guards."""
+    db.create_function("sogh_write_ok", 0, lambda: 1)
+    import hashlib  # the guard of migration 0014 (source_document_series_editions) compares an edition's hash with its content through this function; any writer connection must register it, like sogh_write_ok
+    db.create_function("_g6_sha256_hex", 1, lambda t: hashlib.sha256(t.encode("utf-8")).hexdigest() if isinstance(t, str) else "")
+    db.execute("PRAGMA recursive_triggers=ON")
+    db.execute("PRAGMA foreign_keys=ON")
+    return db
+
